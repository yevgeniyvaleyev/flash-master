{
  "expo": {
    "name": "FlashMaster",
    "slug": "flash-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A66E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.flashmaster.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#3B5BDB",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "scheme": "flashmaster",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "f78bb82b-a9c8-45f2-bbac-4239f49b4e35"
      }
    },
    "owner": "ujeen"
  }
}
